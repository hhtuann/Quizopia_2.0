# Local-only development values. Never use these values in production.
COMPOSE_PROJECT_NAME=quizopia

POSTGRES_PORT=5432
POSTGRES_SUPERUSER=quizopia_admin
POSTGRES_SUPERUSER_PASSWORD=quizopia_admin_local_only

REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=quizopia_local
RABBITMQ_PASSWORD=quizopia_local_only

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=quizopia_minio
MINIO_ROOT_PASSWORD=quizopia_minio_local_only
MINIO_BUCKET=quizopia-local

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-dev-only

# Browser-reachable gateway URL used by the frontend at build/dev time.
NEXT_PUBLIC_API_URL=http://localhost:8080
