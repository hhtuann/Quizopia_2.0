{
  "name": "Quizopia 2.0 Project Context Pack",
  "version": "0.2",
  "milestone": "pre-scaffold architecture baseline",
  "format": "Markdown",
  "application_mode": "overlay onto existing Quizopia_2.0 repository",
  "preserve_existing_files": [
    "docs/reference/legacy-analysis.md",
    ".gitattributes"
  ],
  "remove_obsolete_files": [
    "docs/reference/legacy-summary.md"
  ],
  "accepted_pre_scaffold_decisions": [
    "true monorepo; independent Maven project per backend service",
    "one Next.js frontend and com.quizopia Java package root",
    "Spring Cloud Gateway public edge",
    "Spring Authorization Server; RS256 user JWT; rotating opaque refresh tokens",
    "gateway and each protected service independently validate user JWT",
    "Redis-backed near-immediate revocation",
    "OAuth2 Client Credentials service JWT for synchronous internal REST",
    "RabbitMQ integration events + transactional outbox + idempotent consumers",
    "separate PostgreSQL database and credential per service",
    "MinIO local behind S3-compatible abstraction",
    "PostgreSQL + pgvector initial AI vector baseline",
    "Mailpit local/test email",
    "hybrid local development; no Eureka/Consul baseline",
    "GitHub Actions targeted PR checks + full develop/main checks",
    "OpenAPI-derived frontend contracts",
    "Spotless/ArchUnit/ESLint/Prettier/TypeScript strict",
    "JUnit/Testcontainers/Vitest/RTL/Playwright",
    "structured logging + OpenTelemetry + Actuator/Micrometer",
    "environment-based config; production secrets never in Git"
  ],
  "feature_level_open_areas": [
    "Quiz Markdown grammar",
    "per-question-type grading policy",
    "Publication state/review/result policy and snapshot finalization",
    "guest identity/session",
    "Practice persistence",
    "Proctoring evidence ownership/retention/detectors",
    "Community cross-service reference model",
    "exact import/export templates",
    "AI provider and source-grounding UX"
  ],
