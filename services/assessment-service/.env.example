# Local-only assessment service configuration. Do not commit real values.
SERVER_PORT=8084
DB_URL=jdbc:postgresql://localhost:5432/assessment_db
DB_USERNAME=assessment
DB_PASSWORD=assessment_local_only
IDENTITY_JWKS_URI=http://localhost:8081/oauth2/jwks
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# LD-05 private Identity admission. Disabled means protected operations deny/unavailable.
# Provision a separate least-privilege client for this deployment; no default credentials.
USER_ADMISSION_ENABLED=false
USER_ADMISSION_IDENTITY_BASE_URL=
USER_ADMISSION_CLIENT_ID=
USER_ADMISSION_CLIENT_SECRET=
USER_ADMISSION_ALLOW_INSECURE_LOOPBACK=false
USER_ADMISSION_CONNECT_TIMEOUT=PT1S
USER_ADMISSION_RESPONSE_TIMEOUT=PT3S
USER_ADMISSION_TOTAL_TIMEOUT=PT5S
USER_ADMISSION_MAX_CONNECTIONS=8
USER_ADMISSION_PENDING_ACQUIRES=32
IDENTITY_ISSUER=http://localhost:8081

# W3-A remains disabled pending deployment gates and review.
PUBLICATION_ENABLED=false
PUBLICATION_SOURCES_ENABLED=false
PUBLICATION_QUIZ_BASE_URL=
PUBLICATION_CLASSROOM_BASE_URL=

# B2 Student routes remain disabled pending review/deployment gates. B3 has independent default-off closure/inbox controls.
ATTEMPTS_ENABLED=false
RESULTS_ENABLED=false
CLOSURE_ENABLED=false

# Authorized V4.1 correction. Transaction 1..30s; statement 1..4000ms below JDBC socket 5s.
# Lock timeout 1..statement-millis. Deferred validation runs before COMMIT.
ATTEMPT_TRANSACTION_TIMEOUT_SECONDS=15
ATTEMPT_STATEMENT_TIMEOUT_MILLIS=3000
ATTEMPT_LOCK_TIMEOUT_MILLIS=3000

# B3: verify real authenticated edge routes before setting the readiness attestation.
ASSESSMENT_INBOX_ENABLED=false
ASSESSMENT_CLOSURE_WORKER_ENABLED=false
ASSESSMENT_EDGE_INBOX_VERIFIED=false
ASSESSMENT_RECIPIENT_ELIGIBILITY_ENABLED=false
ASSESSMENT_CLOSURE_UNIT_BUDGET=50
ASSESSMENT_CLOSURE_SCAN_LIMIT=50
ASSESSMENT_CURSOR_ACTIVE_KEY=v1
ASSESSMENT_CURSOR_KEY_V1=
ASSESSMENT_EDGE_BASE_URL=

# Private Proctoring authority. Provision only the exact caller and reviewed SERVICE scope.
ASSESSMENT_PROCTORING_AUTHORITY_ENABLED=false
ASSESSMENT_PROCTORING_CLIENT_ID=
# Isolated non-production loopback testing only; forbidden in prod.
ASSESSMENT_PROCTORING_ALLOW_INSECURE_LOOPBACK=false
