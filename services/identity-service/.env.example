# Local-only identity service configuration. Do not commit real values.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USERNAME=identity
DB_PASSWORD=identity_local_only
IDENTITY_JWKS_URI=http://localhost:8081/oauth2/jwks
IDENTITY_ISSUER=http://localhost:8081
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_AUTHORIZATION_SERVER_ENABLED=true
IDENTITY_AUTHORIZATION_SERVER_SERVICE_ACCESS_TOKEN_TTL=PT1M
IDENTITY_AUTHORIZATION_SERVER_USER_ACCESS_TOKEN_TTL=PT5M
IDENTITY_SIGNING_KEY_KID=quizopia-local-dev
IDENTITY_SIGNING_KEY_PRIVATE_KEY_PATH=.local-secrets/identity-private.pem
IDENTITY_SIGNING_KEY_PUBLIC_KEY_PATH=.local-secrets/identity-public.pem
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_READ_TIMEOUT_MS=10000
MAIL_SMTP_WRITE_TIMEOUT_MS=10000
IDENTITY_EMAIL_OUTBOX_DISPATCHER_ENABLED=true
IDENTITY_EMAIL_FROM_ADDRESS=no-reply@quizopia.local
IDENTITY_EMAIL_OUTBOX_POLLING_INTERVAL=PT5S
IDENTITY_EMAIL_OUTBOX_BATCH_SIZE=20
IDENTITY_EMAIL_OUTBOX_LEASE_DURATION=PT1M
IDENTITY_EMAIL_OUTBOX_MAXIMUM_ATTEMPTS=5
IDENTITY_EMAIL_OUTBOX_INITIAL_RETRY_DELAY=PT30S
IDENTITY_EMAIL_OUTBOX_MAXIMUM_RETRY_DELAY=PT5M
# Supply a separate local secret with 32-byte Base64 key material before startup.
IDENTITY_EMAIL_OUTBOX_ACTIVE_KEY_VERSION=v1
QUIZOPIA_IDENTITY_EMAIL_OUTBOX_ENCRYPTION_KEYS_V1=
# Set these only when using the google profile.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
