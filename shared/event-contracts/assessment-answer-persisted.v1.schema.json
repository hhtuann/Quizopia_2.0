{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assessment answer persisted v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "attemptId",
    "publicationId",
    "classroomId",
    "studentId",
    "attemptStartedAt",
    "deadlineAt",
    "questionNumber",
    "revision"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "publicationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "classroomId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "studentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "attemptStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "const": "ASSESSMENT_ANSWER_PERSISTED"
    },
    "eventVersion": {
      "const": 1
    },
    "questionNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Positive signed 64-bit revision; runtime also enforces <=9223372036854775807."
    }
  }
}
