# Local-only gateway service configuration. Do not commit real values.
SERVER_PORT=8080
IDENTITY_SERVICE_URL=http://localhost:8081
QUIZ_SERVICE_URL=http://localhost:8082
CLASSROOM_SERVICE_URL=http://localhost:8083
ASSESSMENT_SERVICE_URL=http://localhost:8084
COMMUNITY_SERVICE_URL=http://localhost:8085
PROCTORING_SERVICE_URL=http://localhost:8086
AI_SERVICE_URL=http://localhost:8087
IDENTITY_JWKS_URI=http://localhost:8081/oauth2/jwks
IDENTITY_ISSUER=http://localhost:8081
REDIS_HOST=localhost
REDIS_PORT=6379
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# LD-05 private Identity admission. Disabled means protected operations deny/unavailable.
# Provision a separate least-privilege client for this deployment; no default credentials.
USER_ADMISSION_ENABLED=false
USER_ADMISSION_IDENTITY_BASE_URL=
USER_ADMISSION_CLIENT_ID=
USER_ADMISSION_CLIENT_SECRET=
USER_ADMISSION_ALLOW_INSECURE_LOOPBACK=false
USER_ADMISSION_CONNECT_TIMEOUT=PT1S
USER_ADMISSION_RESPONSE_TIMEOUT=PT3S
USER_ADMISSION_TOTAL_TIMEOUT=PT5S
USER_ADMISSION_MAX_CONNECTIONS=8
USER_ADMISSION_PENDING_ACQUIRES=32

# W4-B1 Gateway realtime foundation. Default OFF; B2 subscriptions remain denied.
# Enabling requires working Redis plus LD-05 admission and reviewed edge limits.
REALTIME_ENABLED=false
REALTIME_TICKET_TTL=PT30S
REALTIME_AUTH_TIMEOUT=PT5S
REALTIME_MAXIMUM_FRAME_BYTES=17408
REALTIME_MAXIMUM_OUTSTANDING_TICKETS=10000
REALTIME_TICKET_ISSUE_RATE_PER_ACTOR=20
REALTIME_TICKET_ISSUE_RATE_PER_ORIGIN=200
REALTIME_UPGRADE_RATE_PER_IP=120
REALTIME_MAXIMUM_CONNECTIONS=512
REALTIME_MAXIMUM_CONNECTIONS_PER_IP=64
REALTIME_MAXIMUM_CONNECTIONS_PER_ORIGIN=128

# W4-B2 Assessment realtime subscription authority. Default OFF; SUBSCRIBE fails closed while disabled.
# Requires the dedicated Identity-issued SERVICE client (audience
# quizopia-assessment-realtime-authority, scope assessment.realtime.subscription-authorize).
REALTIME_AUTHORITY_ENABLED=false
REALTIME_AUTHORITY_ASSESSMENT_BASE_URL=
REALTIME_AUTHORITY_IDENTITY_BASE_URL=
REALTIME_AUTHORITY_CLIENT_ID=
REALTIME_AUTHORITY_CLIENT_SECRET=
REALTIME_AUTHORITY_ALLOW_INSECURE_LOOPBACK=false
REALTIME_AUTHORITY_CONNECT_TIMEOUT=PT1S
REALTIME_AUTHORITY_RESPONSE_TIMEOUT=PT3S
REALTIME_AUTHORITY_TOTAL_TIMEOUT=PT5S
REALTIME_AUTHORITY_MAX_CONNECTIONS=8
REALTIME_AUTHORITY_PENDING_ACQUIRES=32
REALTIME_AUTHORITY_MAX_SUBSCRIPTIONS=16

# W4-B3 best-effort RabbitMQ invalidation consumer (default OFF). Each Gateway instance
# owns an exclusive queue on quizopia.realtime.invalidation.v1; REST remains authoritative.
# Provision a dedicated private-vhost read-only consumer identity for this deployment.
REALTIME_INVALIDATION_ENABLED=false
REALTIME_INVALIDATION_ALLOW_INSECURE_LOOPBACK=false
REALTIME_INVALIDATION_BROKER_HOST=
REALTIME_INVALIDATION_BROKER_PORT=5671
REALTIME_INVALIDATION_BROKER_VHOST=
REALTIME_INVALIDATION_BROKER_USERNAME=
REALTIME_INVALIDATION_BROKER_PASSWORD=
REALTIME_INVALIDATION_QUEUE_PREFIX=quizopia.gateway.realtime-invalidation
REALTIME_INVALIDATION_PREFETCH=64
REALTIME_INVALIDATION_DEDUPLICATION_CAPACITY=4096
REALTIME_INVALIDATION_MAXIMUM_REGISTRY_ENTRIES=8192

# W3-A remains disabled pending deployment gates and review.
PUBLICATION_ENABLED=false

# B2 independently gated at Gateway and Assessment; SUBMIT requires both switches.
ATTEMPTS_ENABLED=false
RESULTS_ENABLED=false
CLOSURE_ENABLED=false

# Independent authenticated Student inbox; history stays available with closure disabled.
ASSESSMENT_INBOX_ENABLED=false

# W3-M1 exact adapters; downstream independent admission/authority remains mandatory.
PROCTORING_ENABLED=false
